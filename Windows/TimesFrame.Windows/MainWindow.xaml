<Window x:Class="TimesFrame.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TimesFrame.Windows" Title="TimesFrame 相册管理 · Windows x64 · 0.9.0" Width="1280" Height="820" MinWidth="1080" MinHeight="650" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="12">
  <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,10" VerticalAlignment="Center">
   <TextBlock Text="相框 IP " VerticalAlignment="Center"/><TextBox x:Name="Ip" Width="150"/><TextBlock Text=" 端口 " VerticalAlignment="Center"/><TextBox x:Name="Port" Width="65" Text="9000"/>
   <Button Content="查找设备" Click="Discover_Click"/><ComboBox x:Name="Found" Width="185" SelectionChanged="Found_Changed"/><Button Content="连接" Click="Connect_Click"/><Button Content="核对手机端" Click="Cloud_Click"/>
   <Button Content="账号与设备控制" Click="Settings_Click"/><Button Content="表盘工作台" Click="Workbench_Click"/>
  </WrapPanel>
  <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Connected" Foreground="#486074"/><TextBlock x:Name="Status" Text="输入相框地址并连接。" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="Cancel" Content="取消操作" Click="Cancel_Click" IsEnabled="False"/></Grid>
  <Grid x:Name="Body"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,12,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="设备相册" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,8"/><Button Content="新建设备本地相册…" Click="NewAlbum_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="重命名本地相册…" Click="Rename_Click"/><Button Content="删除本地相册…" Click="DeleteAlbum_Click"/><TextBlock Text="本地新建不自动同步到手机。需要手机可见的相册，请在手机创建后刷新。" TextWrapping="Wrap" Foreground="#677684" Margin="4,8"/></StackPanel><ListBox x:Name="Albums" SelectionChanged="Album_Changed" FontSize="14" Padding="4"/></DockPanel>
   <DockPanel Grid.Column="1">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock x:Name="AlbumTitle" Text="请选择相册" FontSize="18" FontWeight="SemiBold" Margin="4,0,15,0" VerticalAlignment="Center"/><Button Content="刷新" Click="Refresh_Click"/><Button Content="上传图片…" Click="Upload_Click"/><Button Content="上传文件夹…" Click="Folder_Click"/><Button Content="加载更多" Click="More_Click"/></WrapPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><WrapPanel><TextBlock x:Name="Selection" Text="已选 0 张 · Ctrl 点击增减；拖动框选可累加" VerticalAlignment="Center" Margin="4,0,12,0"/><Button Content="全选整个相册" Click="SelectAll_Click"/><Button Content="清空选择" Click="Clear_Click"/></WrapPanel><WrapPanel><Button Content="下载原图…" Click="Download_Click"/><Button Content="加入已有照片…" Click="Existing_Click"/><Button Content="移出相册" Click="Remove_Click"/><Button Content="从设备删除原图…" Click="Delete_Click"/></WrapPanel></StackPanel>
    <local:PhotoGrid x:Name="Photos" SelectionChanged="Photos_Changed" PreviewKeyDown="Photos_Key" Background="White" BorderBrush="#DFE4EA" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="8">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Width="142"><Border Background="#EBEEF2" Width="142" Height="142"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Label}" Margin="0,4,0,0" Foreground="#526473"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </local:PhotoGrid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
